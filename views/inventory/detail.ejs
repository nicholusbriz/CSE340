<div class="detail-wrapper">
  <%- detailHTML %>
</div>

<!-- Comment System -->
<div class="comments-section">
  <h3>Comments (<span id="comment-count">0</span>)</h3>

  <% if (typeof accountData !=='undefined' && accountData) { %>
    <!-- Comment Form -->
    <form method="POST" action="/comments/add" class="comment-form" id="comment-form">
      <input type="hidden" name="inv_id" value="<%= typeof inv_id !== 'undefined' ? inv_id : '' %>">

      <div class="form-group">
        <label for="comment_text">Your Comment:</label>
        <textarea id="comment_text" name="comment_text" rows="3" maxlength="1000"
          placeholder="Share your thoughts about this vehicle..." required></textarea>
        <small id="char-count" class="char-count">0 / 1000 characters</small>
      </div>

      <button type="submit" class="btn btn-primary" id="submit-comment">
        <span id="submit-text">Post Comment</span>
        <span id="submit-loading" style="display: none;">Posting...</span>
      </button>
    </form>
    <% } else { %>
      <!-- Login Required Message -->
      <div class="login-required">
        <p><a href="/account/login">Login</a> to add a comment.</p>
      </div>
      <% } %>

        <!-- Display Comments -->
        <% if (typeof comments !=='undefined' && comments.length> 0) { %>
          <% comments.forEach(comment=> { %>
            <div class="comment-item" data-comment-id="<%= comment.comment_id %>">
              <div class="comment-header">
                <strong>
                  <%= comment.account_firstname %>
                    <%= comment.account_lastname %>
                </strong>
                <small>
                  <%= new Date(comment.comment_date).toLocaleDateString() %>
                </small>
                <% if (typeof accountData !=='undefined' && accountData && accountData.account_id===comment.account_id)
                  { %>
                  <div class="comment-actions">
                    <button type="button" class="btn-edit-comment"
                      onclick="editComment(<%= comment.comment_id %>, '<%= comment.comment_text.replace(/'/g, " \\'")
                      %>')"
                      title="Edit comment">✏️</button>
                    <form method="POST" action="/comments/delete/<%= comment.comment_id %>" style="display: inline;">
                      <button type="submit" class="btn-delete-comment"
                        onclick="return confirm('Are you sure you want to delete this comment?')">🗑️</button>
                    </form>
                  </div>
                  <% } %>
              </div>
              <div class="comment-content" id="comment-content-<%= comment.comment_id %>">
                <%= comment.comment_text %>
              </div>
              <!-- Edit form (hidden by default) -->
              <div class="edit-form" id="edit-form-<%= comment.comment_id %>" style="display: none;">
                <textarea id="edit-text-<%= comment.comment_id %>" rows="3"
                  maxlength="1000"><%= comment.comment_text %></textarea>
                <div class="edit-actions">
                  <button type="button" class="btn btn-success"
                    onclick="saveComment(<%= comment.comment_id %>)">Save</button>
                  <button type="button" class="btn btn-secondary"
                    onclick="cancelEdit(<%= comment.comment_id %>)">Cancel</button>
                </div>
              </div>
            </div>
            <% }) %>
              <% } else { %>
                <p class="no-comments">No comments yet. Be the first to comment!</p>
                <% } %>
</div>

<!-- Flash Messages -->
<% if (typeof messages !=='undefined' && messages.notice) { %>
  <div class="notice">
    <%= messages.notice %>
  </div>
  <% } %>

    <!-- Include comment validation script -->
    <script src="/js/comment-validation.js"></script>
    <script>
      // Comment editing functions
      function editComment(commentId, currentText) {
        const contentDiv = document.getElementById(`comment-content-${commentId}`);
        const editForm = document.getElementById(`edit-form-${commentId}`);
        const editTextarea = document.getElementById(`edit-text-${commentId}`);

        if (contentDiv && editForm && editTextarea) {
          contentDiv.style.display = 'none';
          editForm.style.display = 'block';
          editTextarea.focus();
          editTextarea.value = currentText;
        }
      }

      function cancelEdit(commentId) {
        const contentDiv = document.getElementById(`comment-content-${commentId}`);
        const editForm = document.getElementById(`edit-form-${commentId}`);

        if (contentDiv && editForm) {
          contentDiv.style.display = 'block';
          editForm.style.display = 'none';
        }
      }

      async function saveComment(commentId) {
        const editTextarea = document.getElementById(`edit-text-${commentId}`);
        const newText = editTextarea.value.trim();

        if (!newText) {
          alert('Comment cannot be empty');
          return;
        }

        try {
          const response = await fetch(`/comments/update/${commentId}`, {
            method: 'PUT',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              comment_text: newText
            })
          });

          const result = await response.json();

          if (result.success) {
            // Update the comment content
            const contentDiv = document.getElementById(`comment-content-${commentId}`);
            contentDiv.textContent = newText;

            // Hide edit form
            cancelEdit(commentId);

            // Show success message
            alert('Comment updated successfully!');
          } else {
            alert(result.message || 'Failed to update comment');
          }
        } catch (error) {
          console.error('Error updating comment:', error);
          alert('Error updating comment. Please try again.');
        }
      }

      // Load comment count
      document.addEventListener('DOMContentLoaded', function () {
        const invId = <%= typeof inv_id !== 'undefined' ? inv_id : 'null' %>;
        if (invId) {
          fetch(`/comments/stats/${invId}`)
            .then(response => response.json())
            .then(data => {
              if (data.success) {
                const countElement = document.getElementById('comment-count');
                if (countElement) {
                  countElement.textContent = data.count;
                }
              }
            })
            .catch(error => console.error('Error loading comment count:', error));
        }
      });
    </script>