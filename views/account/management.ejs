<div class="account-management">
    <h1>Account Management</h1>
    
    <%- messages() %>
    
    <% if (locals.loggedin && locals.loggedin === 1) { %>
        <div class="welcome-message">
            <h2>Welcome, <%= accountData.account_firstname %> <%= accountData.account_lastname %>!</h2>
            <p>You're logged in.</p>
            
            <div class="account-info">
                <h3>Account Information</h3>
                <ul>
                    <li><strong>Name:</strong> <%= accountData.account_firstname %> <%= accountData.account_lastname %></li>
                    <li><strong>Email:</strong> <%= accountData.account_email %></li>
                    <li><strong>Account Type:</strong> <%= accountData.account_type %></li>
                </ul>
            </div>
            
            <div class="account-actions">
                <a href="/account/logout" class="btn btn-primary">Logout</a>
            </div>
        </div>
    <% } else { %>
        <div class="not-logged-in">
            <p>You are not logged in.</p>
            <p><a href="/account/login" class="btn btn-primary">Login</a> | <a href="/account/register" class="btn btn-secondary">Register</a></p>
        </div>
    <% } %>
</div>
